/**
 * @fileoverview Firestore Security Rules for VaultSpace.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for most data, with an additional admin override. Each user can only read and write their own data, except for administrators who have full access.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.  Access is restricted to the user themselves and administrators.
 * - /users/{userId}/assets/{assetId}: Stores assets owned by a specific user. Access is restricted to the owner and administrators.
 * - /users/{userId}/activityLogs/{activityLogId}: Stores activity logs for a user. Access is restricted to the owner and administrators.
 * - /roles_admin/{userId}:  A collection used to grant admin privileges. If a document exists for a user ID in this collection, that user is considered an administrator.
 *
 * Key Security Decisions:
 * - User listing is disabled for the /users collection to protect user privacy.
 * - Admin privileges are granted by the existence of a document in the /roles_admin collection.
 *
 * Denormalization for Authorization:
 * - The 'Asset' and 'ActivityLog' entities are located under a user-specific path (/users/{userId}/...). This ensures that the 'userId' is implicitly available in the path, enabling simple, secure rules without requiring extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - An authenticated user can create their own user document with a matching user ID.
     * @allow (get, update, delete) - The owner of the document can read, update, or delete it.
     * @allow (get) - An admin can get any user document.
     * @deny (list) - Listing all user documents is not allowed.
     * @deny (create) - Creating a user document with a mismatched user ID is not allowed.
     * @principle Enforces document ownership for writes; restricts listing users; allows admin read access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/assets/{assetId} collection.
     * @path /users/{userId}/assets/{assetId}
     * @allow (create) - The owner of the parent user document can create an asset.
     * @allow (get, update, delete) - The owner of the parent user document can read, update, or delete the asset.
     * @allow (get) - An admin can get any asset.
     * @deny (list) - Listing all assets is not allowed.
     * @deny (create) - Creating an asset with a mismatched user ID is not allowed.
     * @principle Enforces document ownership for writes; restricts listing assets; allows admin read access.
     */
    match /users/{userId}/assets/{assetId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/activityLogs/{activityLogId} collection.
     * @path /users/{userId}/activityLogs/{activityLogId}
     * @allow (create) - The owner of the parent user document can create an activity log entry.
     * @allow (get, update, delete) - The owner of the parent user document can read, update, or delete the activity log entry.
     * @allow (get) - An admin can get any activity log entry.
     * @deny (list) - Listing all activity log entries is not allowed.
     * @deny (create) - Creating an activity log entry with a mismatched user ID is not allowed.
     * @principle Enforces document ownership for writes; restricts listing activity log entries; allows admin read access.
     */
    match /users/{userId}/activityLogs/{activityLogId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /roles_admin/{userId} collection.
     * @path /roles_admin/{userId}
     * @allow (get) - Anyone can check if a user is an admin (for UI purposes).
     * @allow (create, update, delete) - Only an existing admin can create, update, or delete admin roles.
     * @deny (list) - Listing all admin roles is not allowed.
     * @principle Restricts admin role management to existing admins.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}